+/**
+ * ffmpeg 侧真正跑在专用硬件上的编码器。
+ * 故意不含 h264_mf：它只是 Media Foundation 的通用封装，在没有硬件 MFT 的机器上
+ * （例如 AMD 独显/核显）会静默退回软件编码，把它当硬件会误判。
+ */
+export function isHardwareFfmpegEncoderName(name: string | null | undefined): boolean {
+	if (!name) return false;
+	return /nvenc|qsv|amf|videotoolbox|vaapi/i.test(name);
+}
+
+/**
+ * 问 Chromium：这条 H.264 编码配置是否真的由硬件完成。
+ * `powerEfficient` 是 MediaCapabilities 里专门表达"硬件加速"的信号；WebCodecs 的
+ * `isConfigSupported` 只说明"能编"，在 AMD 上会返回 true 却实际软编，因此不能只看它。
+ */
+export async function isWebCodecsHardwareAccelerated(config: {
+	width: number;
+	height: number;
+	bitrate: number;
+	frameRate: number;
+	codec?: string;
+}): Promise<boolean> {
+	const mediaCapabilities = globalThis.navigator?.mediaCapabilities;
+	if (!mediaCapabilities?.encodingInfo) return false;
+	try {
+		const info = await mediaCapabilities.encodingInfo({
+			type: "record",
+			video: {
+				contentType: `video/mp4; codecs="${config.codec ?? "avc1.640034"}"`,
+				width: config.width,
+				height: config.height,
+				bitrate: config.bitrate,
+				framerate: config.frameRate,
+			},
+		});
+		return info.powerEfficient === true;
+	} catch {
+		return false;
+	}
+}
