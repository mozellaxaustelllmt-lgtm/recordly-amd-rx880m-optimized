+std::vector<std::wstring> MFEncoder::findFfmpegCandidates() {
+    std::vector<std::wstring> candidates;
+    auto push = [&candidates](const std::wstring& path) {
+        if (path.empty() || !fileExists(path)) return;
+        for (const auto& existing : candidates) {
+            if (existing == path) return;
+        }
+        candidates.push_back(path);
+    };
+
+    const std::wstring dir = exeDirectory();
+    // 1) 与 helper 同目录
+    push(joinPath(dir, L"ffmpeg.exe"));
+
+    // 2) 逐级向上找：node_modules\ffmpeg-static（开发态）与 app.asar.unpacked\node_modules\ffmpeg-static（安装态）
+    std::wstring base = dir;
+    for (int up = 0; up < 6; ++up) {
+        const size_t slash = base.find_last_of(L"\\/");
+        if (slash == std::wstring::npos) break;
+        base = base.substr(0, slash);
+        push(joinPath(base, L"node_modules\\ffmpeg-static\\ffmpeg.exe"));
+        push(joinPath(base, L"app.asar.unpacked\\node_modules\\ffmpeg-static\\ffmpeg.exe"));
+        push(joinPath(base, L"ffmpeg.exe"));
+    }
+
+    // 3) PATH
+    wchar_t found[4096] = {};
+    if (SearchPathW(nullptr, L"ffmpeg.exe", nullptr, static_cast<DWORD>(std::size(found)), found,
+                    nullptr) > 0) {
+        push(std::wstring(found));
+    }
+    return candidates;
+}
+
+std::wstring MFEncoder::probeHardwareEncoder(const std::wstring& ffmpegPath) {
+    // 按 AMD -> NVIDIA -> Intel -> Media Foundation 的顺序试一遍，能出 1 帧就算可用。
+    static const wchar_t* kCandidates[] = {L"h264_amf", L"h264_nvenc", L"h264_qsv", L"h264_mf"};
+    for (const wchar_t* candidate : kCandidates) {
+        std::wstring args =
+            L"-hide_banner -loglevel error -nostdin -f lavfi "
+            L"-i color=c=black:s=640x360:r=30 -frames:v 3 -c:v ";
+        args += candidate;
+        args += L" -f null -";
+        if (runHidden(ffmpegPath, args, 20000) == 0) {
+            return std::wstring(candidate);
+        }
+    }
+    return std::wstring();
+}
