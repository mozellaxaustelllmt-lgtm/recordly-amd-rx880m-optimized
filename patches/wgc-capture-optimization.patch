+static std::wstring utf8ToWide(const std::string& str) {    if (str.empty()) return L"";
+
+    // Electron/Node 把 JSON 当命令行参数传进来时，CRT 会在中文系统上把它转成 ANSI(GBK) 字节，
+    // 这里如果一律按 UTF-8 解，路径里有中文（例如 C:\Users\顾磊\...）就会变成乱码，
+    // MFCreateSinkWriterFromURL 直接报 0x80070003 —— 这是原生采集起不来、退回浏览器录制的根因。
+    // 做法：先按 UTF-8 严格解析，失败再按系统 ANSI 代码页解析。
+    UINT codePage = CP_UTF8;
+    int len = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, str.c_str(),
+                                  static_cast<int>(str.size()), nullptr, 0);
+    if (len == 0) {
+        codePage = CP_ACP;
+        len = MultiByteToWideChar(CP_ACP, 0, str.c_str(), static_cast<int>(str.size()), nullptr, 0);
+    }
+    if (len == 0) return L"";
+
+    std::wstring wstr(static_cast<size_t>(len), L'\0');
+    MultiByteToWideChar(codePage, 0, str.c_str(), static_cast<int>(str.size()), &wstr[0], len);
     return wstr;
 }
 
