+    // 桌面抓到的是全范围 BGRA，编码侧要的是有限范围 BT.709（与 bt709_video.h 一致）
+    D3D11_VIDEO_PROCESSOR_COLOR_SPACE inputSpace = {};
+    inputSpace.Usage = 0;
+    inputSpace.RGB_Range = 0;
+    inputSpace.YCbCr_Matrix = 1;
+    inputSpace.YCbCr_xvYCC = 0;
+    inputSpace.Nominal_Range = D3D11_VIDEO_PROCESSOR_NOMINAL_RANGE_0_255;
+    videoContext_->VideoProcessorSetStreamColorSpace(videoProcessor_.Get(), 0, &inputSpace);
+
+    D3D11_VIDEO_PROCESSOR_COLOR_SPACE outputSpace = {};
+    outputSpace.Usage = 0;
+    outputSpace.RGB_Range = 1;
+    outputSpace.YCbCr_Matrix = 1;
+    outputSpace.YCbCr_xvYCC = 0;
+    outputSpace.Nominal_Range = D3D11_VIDEO_PROCESSOR_NOMINAL_RANGE_16_235;
+    videoContext_->VideoProcessorSetOutputColorSpace(videoProcessor_.Get(), &outputSpace);
+    videoContext_->VideoProcessorSetStreamFrameFormat(
+        videoProcessor_.Get(), 0, D3D11_VIDEO_FRAME_FORMAT_PROGRESSIVE);
+
+    // NV12 目标纹理（GPU 上）
+    D3D11_TEXTURE2D_DESC targetDesc = {};
+    targetDesc.Width = static_cast<UINT>(width_);
+    targetDesc.Height = static_cast<UINT>(height_);
+    targetDesc.MipLevels = 1;
+    targetDesc.ArraySize = 1;
+    targetDesc.Format = DXGI_FORMAT_NV12;
+    targetDesc.SampleDesc.Count = 1;
