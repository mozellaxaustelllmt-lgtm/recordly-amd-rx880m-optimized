+bool MFEncoder::startFfmpegPipe(const std::wstring& outputPath, const std::wstring& ffmpegPath,
+                                const std::wstring& encoderName) {
+    if (ffmpegPath.empty() || encoderName.empty()) return false;
+
+    SECURITY_ATTRIBUTES sa = {};
+    sa.nLength = sizeof(sa);
+    sa.bInheritHandle = TRUE;
+
+    HANDLE readEnd = nullptr;
+    HANDLE writeEnd = nullptr;
+    if (!CreatePipe(&readEnd, &writeEnd, &sa, 1 << 20)) {
+        std::cerr << "WARNING: CreatePipe failed: " << GetLastError() << std::endl;
+        return false;
+    }
+    SetHandleInformation(writeEnd, HANDLE_FLAG_INHERIT, 0);
