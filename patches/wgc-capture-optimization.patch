+bool MFEncoder::convertFrameGpu(ID3D11Texture2D* texture) {
+    if (!gpuConverterReady_ || !texture || !videoDevice_ || !videoContext_ ||
+        !videoProcessor_ || !nv12OutputView_ || !nv12StagingTexture_) {
+        return false;
+    }
+
+    // 窗口录制时用户可能改变窗口大小，WGC 会送来不同尺寸的帧。
+    // 视频处理器是按固定输入尺寸建的，尺寸一变就重建一次，避免 Blt 失败或画面错位。
+    D3D11_TEXTURE2D_DESC sourceDesc = {};
+    texture->GetDesc(&sourceDesc);
+    if (static_cast<int>(sourceDesc.Width) != inputWidth_ ||
+        static_cast<int>(sourceDesc.Height) != inputHeight_) {
+        nv12OutputView_.Reset();
+        nv12TargetTexture_.Reset();
+        nv12StagingTexture_.Reset();
+        videoProcessor_.Reset();
+        videoProcessorEnumerator_.Reset();
+        if (!initGpuConverter(static_cast<int>(sourceDesc.Width), static_cast<int>(sourceDesc.Height))) {
+            std::cerr << "WARNING: GPU converter rebuild failed for "
+                      << sourceDesc.Width << "x" << sourceDesc.Height << std::endl;
+            gpuConverterReady_ = false;
+            return false;
+        }
+        std::cerr << "INFO: GPU converter rebuilt for "
+                  << inputWidth_ << "x" << inputHeight_ << std::endl;
+    }
+
+    D3D11_VIDEO_PROCESSOR_INPUT_VIEW_DESC inputViewDesc = {};
+    inputViewDesc.FourCC = 0;
+    inputViewDesc.ViewDimension = D3D11_VPIV_DIMENSION_TEXTURE2D;
+    inputViewDesc.Texture2D.MipSlice = 0;
+    inputViewDesc.Texture2D.ArraySlice = 0;
+
+    ComPtr<ID3D11VideoProcessorInputView> inputView;
+    HRESULT hr = videoDevice_->CreateVideoProcessorInputView(
+        texture, videoProcessorEnumerator_.Get(), &inputViewDesc, &inputView);
+    if (FAILED(hr)) return false;
+
+    D3D11_VIDEO_PROCESSOR_STREAM stream = {};
+    stream.Enable = TRUE;
+    stream.OutputIndex = 0;
+    stream.InputFrameOrField = 0;
+    stream.pInputSurface = inputView.Get();
+
+    hr = videoContext_->VideoProcessorBlt(videoProcessor_.Get(), nv12OutputView_.Get(), 0, 1, &stream);
+    if (FAILED(hr)) return false;
+
+    context_->CopyResource(nv12StagingTexture_.Get(), nv12TargetTexture_.Get());
+
+    D3D11_MAPPED_SUBRESOURCE mapped = {};
+    hr = context_->Map(nv12StagingTexture_.Get(), 0, D3D11_MAP_READ, 0, &mapped);
+    if (FAILED(hr)) return false;
+
+    const auto* yPlane = static_cast<const uint8_t*>(mapped.pData);
+    // 平面格式的 DepthPitch 是 U/V 平面相对 Y 平面的偏移；个别驱动给 0，兜底用 RowPitch*height。
+    size_t uvOffset = static_cast<size_t>(mapped.RowPitch) * static_cast<size_t>(height_);
+    if (mapped.DepthPitch > uvOffset) uvOffset = static_cast<size_t>(mapped.DepthPitch);
+    const auto* uvPlane = yPlane + uvOffset;
+
+    uint8_t* dstY = nv12Buffer_.data();
+    for (int row = 0; row < height_; ++row) {
+        std::memcpy(dstY + static_cast<size_t>(row) * width_,
+                    yPlane + static_cast<size_t>(row) * mapped.RowPitch,
+                    static_cast<size_t>(width_));
+    }
+    uint8_t* dstUv = nv12Buffer_.data() + static_cast<size_t>(width_) * height_;
+    for (int row = 0; row < height_ / 2; ++row) {
+        std::memcpy(dstUv + static_cast<size_t>(row) * width_,
+                    uvPlane + static_cast<size_t>(row) * mapped.RowPitch,
+                    static_cast<size_t>(width_));
+    }
+
+    context_->Unmap(nv12StagingTexture_.Get(), 0);
+    return true;
+}
