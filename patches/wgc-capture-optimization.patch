+/** 宽字符串 → UTF-8。给 Electron 解析 stdout 用（它按 UTF-8 解码）。 */
+static std::string wideToUtf8(const std::wstring& str) {
+    if (str.empty()) return "";
+    const int len = WideCharToMultiByte(CP_UTF8, 0, str.c_str(), static_cast<int>(str.size()),
+                                        nullptr, 0, nullptr, nullptr);
+    if (len <= 0) return "";
+    std::string out(static_cast<size_t>(len), '\0');
+    WideCharToMultiByte(CP_UTF8, 0, str.c_str(), static_cast<int>(str.size()), &out[0], len,
+                        nullptr, nullptr);
+    return out;
