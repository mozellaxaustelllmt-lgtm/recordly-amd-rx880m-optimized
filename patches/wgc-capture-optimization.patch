+
+    std::wstring commandLine = args.str();
+    std::vector<wchar_t> buffer(commandLine.begin(), commandLine.end());
+    buffer.push_back(L'\0');
+
+    STARTUPINFOW si = {};
+    si.cb = sizeof(si);
+    si.dwFlags = STARTF_USESTDHANDLES | STARTF_USESHOWWINDOW;
+    si.wShowWindow = SW_HIDE;
+    si.hStdInput = readEnd;
+    si.hStdOutput = errOut != INVALID_HANDLE_VALUE ? errOut : GetStdHandle(STD_OUTPUT_HANDLE);
+    si.hStdError = errOut != INVALID_HANDLE_VALUE ? errOut : GetStdHandle(STD_ERROR_HANDLE);
+
+    PROCESS_INFORMATION pi = {};
+    const BOOL started = CreateProcessW(ffmpegPath.c_str(), buffer.data(), nullptr, nullptr, TRUE,
+                                        CREATE_NO_WINDOW, nullptr, nullptr, &si, &pi);
+    CloseHandle(readEnd);
+    if (nulIn != INVALID_HANDLE_VALUE) CloseHandle(nulIn);
+    if (errOut != INVALID_HANDLE_VALUE) CloseHandle(errOut);
+
+    if (!started) {
+        std::cerr << "WARNING: could not start ffmpeg, error " << GetLastError() << std::endl;
+        CloseHandle(writeEnd);
+        return false;
+    }
+
+    std::cerr << "INFO: ffmpeg pid " << pi.dwProcessId << " encoder " << narrow(encoderName)
+              << std::endl;
+
+    pipeStdin_ = writeEnd;
+    pipeProcess_ = pi.hProcess;
+    pipeThread_ = pi.hThread;
+    return true;
+}
+
+bool MFEncoder::writePipeFrames(const std::vector<uint8_t>& frameBuffer, int64_t frameCount) {
+    if (!pipeMode_ || pipeStdin_ == nullptr || frameBuffer.empty() || frameCount <= 0) {
+        return false;
+    }
+    static const int64_t kMaxCatchUpFrames = 600;  // 病态卡顿时的兜底，避免一次性灌几十秒
+    if (frameCount > kMaxCatchUpFrames) frameCount = kMaxCatchUpFrames;
+
+    for (int64_t index = 0; index < frameCount; ++index) {
+        const BYTE* data = frameBuffer.data();
+        DWORD remaining = static_cast<DWORD>(frameBuffer.size());
+        while (remaining > 0) {
+            DWORD written = 0;
+            if (!WriteFile(pipeStdin_, data, remaining, &written, nullptr) || written == 0) {
+                std::cerr << "ERROR: ffmpeg pipe write failed: " << GetLastError() << std::endl;
+                return false;
+            }
+            data += written;
+            remaining -= written;
+        }
+    }
+    return true;
+}
+
+void MFEncoder::closeFfmpegPipe() {
+    if (pipeStdin_ != nullptr) {
+        FlushFileBuffers(pipeStdin_);
+        CloseHandle(pipeStdin_);
+        pipeStdin_ = nullptr;
+    }
+    if (pipeProcess_ != nullptr) {
+        const DWORD wait = WaitForSingleObject(pipeProcess_, 30000);
+        DWORD code = 1;
+        if (wait == WAIT_OBJECT_0 && GetExitCodeProcess(pipeProcess_, &code) && code != 0) {
+            std::cerr << "WARNING: ffmpeg exited with code " << code << std::endl;
+        } else if (wait == WAIT_OBJECT_0 && !pipeLogPath_.empty()) {
+            // 正常结束：删掉空的 ffmpeg 日志，避免在临时目录里留垃圾
+            DeleteFileW(pipeLogPath_.c_str());
+        } else if (wait != WAIT_OBJECT_0) {
+            std::cerr << "WARNING: ffmpeg did not exit in time" << std::endl;
+            TerminateProcess(pipeProcess_, 1);
+        }
+        CloseHandle(pipeProcess_);
+        pipeProcess_ = nullptr;
+    }
+    if (pipeThread_ != nullptr) {
+        CloseHandle(pipeThread_);
+        pipeThread_ = nullptr;
+    }
+    pipeMode_ = false;
+}
+
+bool MFEncoder::initGpuConverter(int inputWidth, int inputHeight) {
+    if (!device_ || !context_) return false;
+    if (inputWidth < 2 || inputHeight < 2) return false;
+    inputWidth_ = inputWidth;
+    inputHeight_ = inputHeight;
+
+    if (FAILED(device_->QueryInterface(IID_PPV_ARGS(&videoDevice_)))) {
+        std::cerr << "INFO: ID3D11VideoDevice unavailable on this device" << std::endl;
+        return false;
