+    const std::wstring ffmpegLogPath = outputPath + L".ffmpeg.log";
+    pipeLogPath_ = ffmpegLogPath;
+    HANDLE errOut = CreateFileW(ffmpegLogPath.c_str(), GENERIC_WRITE,
+                                FILE_SHARE_READ | FILE_SHARE_WRITE, &sa, CREATE_ALWAYS, 0, nullptr);
+
+    const UINT32 bitrate = calculateScreenRecordingBitrate(width_, height_, fps_);
+    // 各家的码率控制/质量档参数不一样，按编码器补上，避免默认值把 UI 录成糊的。
+    std::wstring qualityArgs;
+    if (encoderName == L"h264_amf") {
+        qualityArgs = L" -quality balanced -rc cbr";
+    } else if (encoderName == L"h264_nvenc") {
+        qualityArgs = L" -preset p5 -rc cbr";
+    } else if (encoderName == L"h264_qsv") {
+        qualityArgs = L" -preset medium";
+    }
+
+    std::wostringstream args;
+    // 注意：这里绝对不能加 -nostdin，否则 ffmpeg 会忽略 stdin（我们的帧管道），写入会阻塞。
+    args << L" -hide_banner -loglevel error -y"
+         << L" -f rawvideo -pix_fmt nv12 -s " << width_ << L"x" << height_
+         << L" -r " << fps_ << L" -i - -an"
+         << L" -c:v " << encoderName
+         << qualityArgs
+         << L" -b:v " << bitrate
+         << L" -maxrate " << (bitrate * 3 / 2)
+         << L" -bufsize " << (bitrate * 2)
+         << L" -pix_fmt yuv420p"
+         << L" -colorspace bt709 -color_primaries bt709 -color_trc bt709 -color_range tv"
+         << L" -movflags +frag_keyframe+empty_moov+default_base_moof"
