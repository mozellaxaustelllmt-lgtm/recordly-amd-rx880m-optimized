+    if (FAILED(videoProcessorEnumerator_->CheckVideoProcessorFormat(DXGI_FORMAT_NV12, &formatSupport)) ||
+        (formatSupport & D3D11_VIDEO_PROCESSOR_FORMAT_SUPPORT_OUTPUT) == 0) {
